#!/bin/bash

# === GESTORE MONITOR ESTERNO ROFI ===
# Aggiornato per Hyprland 0.55+ (config Lua)

MONITOR_CONF="$HOME/.config/hypr/monitor.lua"

# Funzione per ottenere monitor ordinati
get_monitors(){
    local mons=($(hyprctl monitors | grep "Monitor" | grep -v "disabled" | awk '{print $2}'))
    local sorted=()

    for m in "${mons[@]}"; do
        [[ "$m" == "eDP-1" ]] && sorted+=("$m")
    done
    for m in "${mons[@]}"; do
        [[ "$m" != "eDP-1" ]] && sorted+=("$m")
    done

    echo "${sorted[@]}"
}

# Funzione per settare il mirroring degli schermi
monitor_mirroring(){
    > "$MONITOR_CONF"

    local monitors=($(get_monitors))
    local main_monitor="${monitors[0]}"
    echo "hl.monitor({ output = \"$main_monitor\", mode = \"preferred\", position = \"auto\", scale = 1 })" >> "$MONITOR_CONF"

    for (( i=1; i<${#monitors[@]}; i++ )); do
        mirror_monitor="${monitors[$i]}"
        echo "hl.monitor({ output = \"$mirror_monitor\", mode = \"preferred\", position = \"auto\", scale = 1, mirror = \"$main_monitor\" })" >> "$MONITOR_CONF"
    done

    hyprctl reload
}

# Mostra il menu
choice=$(echo -e "External Monitor mode:\n--------------------\nMove\nMirror\nReload\n--------------------\nExit" | rofi -dmenu -i -p "Gestione Monitor Esterno")

# Gestione scelte
case "$choice" in
    "Move")
        exec "$HOME/.config/rofi/Monitor/rofi-move-monitor" "$MONITOR_CONF"
        ;;
    "Mirror")
        monitor_mirroring
        ;;
    "Reload")
        exec "$HOME/.config/rofi/Monitor/rofi-reload-monitor"
        ;;
    
    *)
        exit 0
        ;;
esac