#!/bin/bash

# === GESTIONE MONITOR ESTERNO PER SPEGNIMENTO SCHERMO PRICIPALE ===
# Aggiornato per Hyprland 0.55+ (config Lua)

notify-send "Monitor" "Monitor interface reloaded"

# Nomi monitor - cambiali se necessario
INTERNAL="eDP-1"

# Funzione per leggere lo stato del coperchio
lid_closed() {
    grep -q closed /proc/acpi/button/lid/LID*/state
}

# Funzione per verificare se il monitor esterno è collegato
external_connected() {
    hyprctl monitors | grep "Monitor" | grep -v "$INTERNAL"
}

if lid_closed && external_connected; then # Se il coperchio viene chiuso
    hyprctl eval "hl.monitor({ output = \"$INTERNAL\", disabled = true })" # Disabilita il primo schermo
else # Se il coperchio viene aperto riattiva lo schermo eDP-1
    hyprctl eval "hl.monitor({ output = \"$INTERNAL\", mode = \"preferred\", position = \"auto\", scale = 1, disabled = false })"
    hyprctl reload
fi